# Copiar a etl/.env y completar. NUNCA commitear etl/.env.
# Supabase Dashboard → Project Settings → API

# URL del proyecto, ej: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Service role key (secreta: saltea RLS, solo para el ETL offline; no usar en el frontend)
SUPABASE_SERVICE_ROLE_KEY=

# NASA FIRMS → https://firms.modaps.eosdis.nasa.gov/api/map_key/  (para fetch_firms.py)
FIRMS_MAP_KEY=

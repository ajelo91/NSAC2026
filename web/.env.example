# Copiar a .env.local. Sin estas variables la app usa datos mock en memoria (lib/mockData.ts).
# Supabase Dashboard → Project Settings → API (usar la clave pública anon, nunca la service role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapa base oscuro de CARTO: clave gratuita en https://carto.com/basemaps/apikey
# (sin clave la app usa Esri Dark Gray automáticamente)
NEXT_PUBLIC_CARTO_API_KEY=

# Meteomatics (condiciones actuales en las 4 estaciones). SOLO servidor: sin prefijo NEXT_PUBLIC_.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=
